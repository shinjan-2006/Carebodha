    "@vercel/blob": "2.8.0",
    "better-auth": "1.7.7",
    "dotenv": "18.0.6",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "pdf-parse": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tesseract.js": "7.0.0",
    "three": "0.186.1",
