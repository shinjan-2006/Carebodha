DATABASE_URL="postgresql://carebodha:carebodha_local@127.0.0.1:5432/carebodha"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
APP_MODE="normal"
DEMO_SEED_PASSWORD="CareBodha-demo-2026!"
STORAGE_DRIVER="local"
PRIVATE_STORAGE_PATH="./private-storage"
OCR_ENABLED="false"
AI_PROVIDER="manual"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL=""
AI_API_KEY=""
# Set APP_MODE=normal, AI_PROVIDER=openai-compatible and provider credentials for live requests.
# Demo seed is refused in production and in normal mode; use a separate database for normal data.
# Optional private S3 storage (credentials only on server):
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Vercel: connect a private Blob store and set STORAGE_DRIVER=vercel-blob.
# Its BLOB_READ_WRITE_TOKEN stays server-only. Never expose it with NEXT_PUBLIC_.
# Set a unique BETTER_AUTH_SECRET and the production HTTPS BETTER_AUTH_URL.

# Optional server speech fallback for all seven languages. Keep the key server-only.
# Enable after authorizing Sarvam to synthesize clinician-approved instruction text.
TTS_PROVIDER="none"
SARVAM_API_KEY=""

# Phone OTP and opted-in medication reminder messages (server only).
SMS_PROVIDER="none"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
# Twilio Verify sends provider-generated OTPs, including on eligible trial accounts.
# This does not enable custom medicine-reminder SMS.
PHONE_OTP_PROVIDER="none"
TWILIO_VERIFY_SERVICE_SID=""
